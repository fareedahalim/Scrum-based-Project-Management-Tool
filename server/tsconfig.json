{
  "compilerOptions": {
    "target": "ES2020",

    "module": "Node16",
    "moduleResolution": "Node16",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"],

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}